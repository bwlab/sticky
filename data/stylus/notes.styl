@import 'util.styl';
@import 'colors.styl';

.notes-window {
  .notes-box {
    border-spacing: 6px;

    row {
      border-radius: 2px;
    }
  }

  .notes {
    padding: 0 6px 6px 6px;
  }

  .note-view {
    padding: 12px;
  }

  .search-bar {
    padding: 0 3px 12px;
  }

  listview > row {
    background-color: inherit;
  }

  .card-text-view {
    background-color: transparent;
    color: inherit;
  }
}

.note-card {
  border-radius: 2px;
  box-shadow: 0 1px 1px rgba(0, 0, 0, 0.18), 0 5px 8px -5px rgba(0, 0, 0, 0.3);
}

for name, info in colors {
  .note-card.style-{name} {
    background-color: info.bg;
    color: info.fg;

    selection:focus-within {
      background-color: gtkalpha(
        info.ink,
        0.3
      );
    }
  }
}
